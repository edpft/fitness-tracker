  "query": "\n            SELECT id AS \"id!: i64\", name AS \"name!: String\",\n                   authored_at AS \"authored_at!: String\",\n                   chain AS \"chain: String\"\n            FROM plan AS p\n            WHERE p.authored_at = (\n                SELECT MAX(q.authored_at) FROM plan AS q WHERE q.name = p.name\n            )\n            ORDER BY id ASC\n            ",
