  "query": "\n            SELECT id            AS \"id!: i64\",\n                   started_at    AS \"started_at!: String\",\n                   finished_at   AS \"finished_at!: String\",\n                   events_seen   AS \"events_seen!: i64\",\n                   records_landed AS \"records_landed!: i64\"\n            FROM extraction_run\n            WHERE stream = ? AND outcome = 'succeeded'\n            ORDER BY finished_at DESC\n            LIMIT 1\n            ",
